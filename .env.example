APP_NAME="Digital Vision"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Debe coincidir con cómo entrás por navegador (mismo host y puerto) o algunas rutas pueden fallar.
# El reproductor usa URLs relativas para /play/…; igual conviene APP_URL=http://127.0.0.1:8001 si usás artisan serve así.
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_TIMEZONE=UTC

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=reproductor_web
# DB_USERNAME=root
# DB_PASSWORD=

# Opcional: si sirves medios con rclone (http/WebDAV), restringe URLs a este prefijo.
RCLONE_BASE_URL=
RCLONE_AUTH_USER=
RCLONE_AUTH_PASS=

# Binario rclone en el PATH (VPS/Linux) para `php artisan media:rclone-check`. Ej.: /usr/bin/rclone
RCLONE_PATH=rclone

# --- Biblioteca local: RaiDrive (Windows) vs rclone mount (VPS) ---
# auto     → Windows: RAIDRIVE_* si hay rutas; si no, RCLONE_MOUNT_*.
#            Linux: RCLONE_MOUNT_* primero; si no, RAIDRIVE_* (compat. configs viejas).
# raidrive → Solo RAIDRIVE_LOCAL_PATH / RAIDRIVE_LOCAL_PATHS.
# rclone   → Solo RCLONE_MOUNT_PATH / RCLONE_MOUNT_PATHS.
LOCAL_LIBRARY_DRIVER=auto

# Windows + RaiDrive: una raíz o varias letras (comas). Si PATHS no está vacío, PATH se ignora.
RAIDRIVE_LOCAL_PATH=
# Ej.: RAIDRIVE_LOCAL_PATHS="R:\,S:\,T:\,U:\"
RAIDRIVE_LOCAL_PATHS=

# VPS/Linux: una ruta ABSOLUTA por montaje (equivalente a varias letras RaiDrive). No confundir RCLONE_PATH = binario.
# Una raíz: RCLONE_MOUNT_PATH=/var/www/media/dropbox
# Varias (comas; si PATHS no está vacío, PATH se ignora):
# RCLONE_MOUNT_PATHS="/var/www/media/dropbox,/var/www/media/drive,/var/www/media/otro"
RCLONE_MOUNT_PATH=
RCLONE_MOUNT_PATHS=

# Caché de carpetas/archivos en el panel Biblioteca local (segundos). 0 = sin caché.
RAIDRIVE_BROWSE_CACHE_TTL=120
# Caché del recuento recursivo de vídeos bajo la raíz (segundos). 0 = sin caché.
RAIDRIVE_DISK_STATS_CACHE_TTL=300

# Si es true, al abrir Biblioteca local se escanea el disco para contar vídeos (lento con RaiDrive). Por defecto false.
RAIDRIVE_INDEX_DISK_STATS=false

# Máximo de archivos por importación recursiva desde el panel (Biblioteca local).
RAIDRIVE_IMPORT_RECURSIVE_MAX=2500
# Con TMDB_AUTO_POSTER_ON_IMPORT: en recursivo NO se enriquece por defecto (evita miles de HTTP). Forzar:
# RAIDRIVE_IMPORT_RECURSIVE_ENRICH_TMDB=true

# TMDB — carátulas (VOD/Series). En themoviedb.org/settings/api usá el valor "API Key" (v3); no el Access Token v4.
TMDB_API_KEY=
TMDB_LANGUAGE=es-ES
TMDB_IMAGE_BASE=https://image.tmdb.org/t/p/w500
TMDB_HTTP_TIMEOUT=12
TMDB_DELAY_MS=200
# Si es true, cada import desde RaiDrive consulta TMDB (lento en importaciones masivas).
TMDB_AUTO_POSTER_ON_IMPORT=false

# Películas/VOD: TTL del token al preparar reproducción (minutos).
PLAYBACK_TOKEN_TTL_MINUTES=30
# Canales tipo Live IPTV/HLS suelen necesitar TTL largo porque el mismo token se usa en cada segmento hasta 24 h (valor cap en código).
PLAYBACK_TOKEN_TTL_LIVE_MINUTES=480

# Proxy HLS (reproducción canales listas IPTV). Si el jugador queda colgado sin error:
# — muchas fuentes exigen Referer: descomentá una de estas líneas y ajustá URL del panel.
# HLS_UPSTREAM_REFERER=https://tu-panel-iptv.example/
# HLS_UPSTREAM_REFERER_POLICY=request
# HLS_UPSTREAM_REFERER_POLICY=catalog
# HLS_UPSTREAM_REFERER_POLICY=none
# En local ante certificados inválidos upstream (no en producción): HLS_UPSTREAM_VERIFY_SSL=false
# HLS_UPSTREAM_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/121.0.0.0 Safari/537.36"
# HLS_UPSTREAM_CONNECT_TIMEOUT=25
# HLS_UPSTREAM_TIMEOUT=180
# Timeout solo para la playlist inicial (evita esperas de varios minutos si el canal no responde):
# HLS_UPSTREAM_MANIFEST_TIMEOUT=35
# HLS_PROXY_SAME_ORIGIN_ONLY=false

# Transcodificación FFmpeg (ruta /transcode/{content}/{token}; audio AAC para AC3/DTS en navegador)
# FFMPEG_ENABLED=true
# FFMPEG_BIN=ffmpeg
# FFMPEG_MAX_CONCURRENT=3

# Carrusel inicio: vignette vídeo mute (MP4/WebM/HLS local o remoto). Token corto y segundos de bucle.
STREAMING_HERO_PREVIEW_TOKEN_TTL=4
STREAMING_HERO_PREVIEW_CLIP_SECONDS=40

# Pantalla /login y experiencia cliente (streaming)
# Opcional URL de imagen de fondo para /login (vacío = degradado).
LOGIN_BACKGROUND_URL=
# Texto que aparece sobre el formulario de acceso (por defecto DIGITALVISION).
STREAMING_LOGIN_BRAND=DIGITALVISION
# Opcional: fondo del catálogo y selector de perfil (vacío = degradado).
STREAMING_APP_BACKGROUND_URL=

# Fondo de la pantalla de elegir espacio (/app/profiles). Tiene prioridad la ruta Admin «Apariencia cliente».
STREAMING_PROFILES_PICKER_BG_URL=
STREAMING_PROFILES_PICKER_BG_DEFAULT=

# Suscripción: si es true, el acceso permite hasta el último instante del día de vencimiento (en APP_TIMEZONE).
SUBSCRIPTION_EXPIRE_AFTER_END_OF_DAY=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Listas M3U / escaneo de canales (admin → Gestión M3U). Por defecto soporta catálogos grandes (~3k+).
# M3U_SCAN_MAX_DEAD_LISTED=8000
# M3U_SCAN_ALIVE_SAMPLE_SIZE=500
# M3U_DRY_RUN_DEAD_SAMPLE_LIMIT=3500

VITE_APP_NAME="${APP_NAME}"
